# Copia este archivo como .env para cambiar los valores por defecto de docker-compose.
# El archivo .env no se versiona: aquí van solo valores de desarrollo local.

# PostgreSQL (una instancia por servicio)
QUESTION_DB_USER=question
QUESTION_DB_PASSWORD=question

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# headers: la identidad llega en X-User-Id y X-User-Roles (solo desarrollo). jwt: valida un token de Keycloak.
SECURITY_MODE=headers
