# Copia este archivo como .env para cambiar los valores por defecto de docker-compose.
# El archivo .env no se versiona: aquí van solo valores de desarrollo local.

# PostgreSQL (una instancia por servicio con datos; validation-service no tiene base)
USER_DB_USER=userdb
USER_DB_PASSWORD=userdb
QUESTION_DB_USER=question
QUESTION_DB_PASSWORD=question
LIFECYCLE_DB_USER=lifecycle
LIFECYCLE_DB_PASSWORD=lifecycle
ASSIGNMENT_DB_USER=assignment
ASSIGNMENT_DB_PASSWORD=assignment
EVALUATION_DB_USER=evaluation
EVALUATION_DB_PASSWORD=evaluation
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=notification
EMAIL_DB_USER=email
EMAIL_DB_PASSWORD=email
HISTORY_DB_USER=history
HISTORY_DB_PASSWORD=history
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=audit
SIMULATION_DB_USER=simulation
SIMULATION_DB_PASSWORD=simulation
TRACKING_DB_USER=tracking
TRACKING_DB_PASSWORD=tracking

# Revisión (máximo de revisores por pregunta), correo simulado, simulacros (máximo de preguntas) y estadísticas
# (umbrales de fortaleza y debilidad, en % de aciertos)
ASSIGNMENT_MAX_REVIEWERS=3
EMAIL_DOMAIN=bancopreguntas.local
EMAIL_ATTEMPTS=3
SIMULATION_MAX_QUESTIONS=50
TRACKING_STRENGTH_THRESHOLD=70
TRACKING_WEAKNESS_THRESHOLD=50
TRACKING_MIN_ANSWERED=5

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Keycloak (autenticación). KEYCLOAK_PUBLIC_URL es la dirección con la que los navegadores llegan a Keycloak y
# debe coincidir con el emisor (iss) de los tokens.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-admin-client-secret

# jwt (valida el token de Keycloak) o headers (la identidad llega en X-User-Id y X-User-Roles; solo desarrollo)
SECURITY_MODE=jwt

# Orígenes del navegador que pueden llamar al gateway (separados por comas)
GATEWAY_ALLOWED_ORIGINS=http://localhost:4200
