# Copia este archivo como .env para cambiar los valores por defecto de docker-compose.
# El archivo .env no se versiona: aquí van solo valores de desarrollo local.

# PostgreSQL (una instancia por servicio)
USER_DB_USER=userdb
USER_DB_PASSWORD=userdb
QUESTION_DB_USER=question
QUESTION_DB_PASSWORD=question
REVIEW_DB_USER=review
REVIEW_DB_PASSWORD=review
REVIEW_MAX_REVIEWERS=5
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=notification
HISTORY_DB_USER=history
HISTORY_DB_PASSWORD=history

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Keycloak (autenticación). KEYCLOAK_PUBLIC_URL es la dirección con la que los navegadores llegan a Keycloak y
# debe coincidir con el emisor (iss) de los tokens.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-admin-client-secret

# jwt (valida el token de Keycloak) o headers (la identidad llega en X-User-Id y X-User-Roles; solo desarrollo)
SECURITY_MODE=jwt

# Orígenes del navegador que pueden llamar al gateway (separados por comas)
GATEWAY_ALLOWED_ORIGINS=http://localhost:4200
