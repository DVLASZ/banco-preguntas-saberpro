{
  "realm": "bancopreguntas",
  "displayName": "Banco de Preguntas Saber Pro",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT", "LOGOUT_ERROR"],
  "adminEventsEnabled": false,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Administra el banco: asigna revisores y publica preguntas" },
      { "name": "AUTHOR", "description": "Crea, corrige y envía preguntas a revisión" },
      { "name": "REVIEWER", "description": "Evalúa las preguntas que se le asignan" },
      { "name": "TEACHER", "description": "Docente: consulta simulacros, el seguimiento de los estudiantes y los reportes del grupo" },
      { "name": "STUDENT", "description": "Estudiante: genera y presenta simulacros y consulta su propio seguimiento" }
    ]
  },
  "clients": [
    {
      "clientId": "bancopreguntas-web",
      "name": "Aplicación web del banco de preguntas",
      "description": "Cliente público de la aplicación Angular: flujo de código con PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "bancopreguntas-admin",
      "name": "Servicio de usuarios",
      "description": "Cuenta de servicio con permiso de solo lectura de usuarios y eventos; la usa user-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-admin-client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
