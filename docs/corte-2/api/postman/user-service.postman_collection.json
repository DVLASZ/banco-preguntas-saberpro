    {
      "name": "1 · Perfil",
      "item": [
        {
          "name": "Mi perfil (autor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('es el autor1 con rol AUTHOR', function () { pm.expect(j.id).to.eql('autor1'); pm.expect(j.roles).to.include('AUTHOR'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAutor}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/users/me"
          }
        },
