                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('incluye a los 8 usuarios de demostración', function () { pm.expect(pm.response.json().contenido.length).to.be.at.least(8); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
