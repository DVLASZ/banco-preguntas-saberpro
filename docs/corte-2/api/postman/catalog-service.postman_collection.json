    {
      "name": "2 · Catálogo",
      "item": [
        {
          "name": "Resumen del catálogo (estudiante)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// los eventos viajan por RabbitMQ: se espera un momento antes de consultar",
                  "setTimeout(function () {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('hay preguntas publicadas de lectura crítica', function () { pm.expect(j.total).to.be.at.least(1); pm.expect(j.porCompetencia.LECTURA_CRITICA).to.be.at.least(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
