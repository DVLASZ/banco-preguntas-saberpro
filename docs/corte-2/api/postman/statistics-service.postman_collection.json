    {
      "name": "2 · El estudiante",
      "item": [
        {
          "name": "RF-25 Mi historial de simulacros",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// los eventos viajan por RabbitMQ: se espera un momento antes de consultar",
                  "setTimeout(function () {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('incluye el simulacro terminado con su puntaje', function () { var e = j.contenido.filter(function (x) { return x.simulacroId === pm.collectionVariables.get('simId'); }); pm.expect(e.length).to.eql(1); pm.expect(e[0].puntaje).to.eql(100); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante1}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/statistics/me/history"
          }
        },
        {
          "name": "RF-26 Mis estadísticas individuales",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('cuenta los simulacros y calcula el promedio', function () { pm.expect(j.simulacros).to.be.at.least(1); pm.expect(j.puntajePromedio).to.be.within(0, 100); pm.expect(j.mejorPuntaje).to.eql(100); });",
                  "pm.test('trae el desempeño por competencia', function () { pm.expect(j.porCompetencia.length).to.be.at.least(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante1}}",
                  "type": "string"
                }
