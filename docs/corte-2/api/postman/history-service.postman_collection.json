    {
      "name": "1 · Preparación",
      "item": [
        {
          "name": "Preparar · crear una pregunta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (201)', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('qId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAutor}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Idea principal de un texto\",\n  \"contexto\": \"La energía solar se ha vuelto una alternativa limpia y cada vez más barata frente a los combustibles fósiles.\",\n  \"enunciado\": \"¿Cuál es la idea principal del texto?\",\n  \"opcionA\": \"La energía solar es costosa\",\n  \"opcionB\": \"La energía solar es una alternativa limpia y económica\",\n  \"opcionC\": \"Los combustibles fósiles son renovables\",\n  \"opcionD\": \"La energía solar solo sirve de día\",\n  \"respuestaCorrecta\": \"B\",\n  \"justificacion\": \"El texto presenta la energía solar como alternativa limpia y barata.\",\n  \"bibliografia\": \"Texto de ejemplo, 2026\",\n  \"competencia\": \"LECTURA_CRITICA\",\n  \"tema\": \"Idea principal\",\n  \"subtema\": \"Textos argumentativos\",\n  \"dificultad\": \"BASICO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/questions"
          }
        },
        {
          "name": "Preparar · enviar la pregunta a revisión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAutor}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/questions/{{qId}}/submit"
          }
        },
        {
          "name": "Preparar · asignar dos revisores",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// el envío viaja por RabbitMQ hasta assignment-service: se espera antes de asignar",
                  "setTimeout(function () {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewerIds\": [\n    \"revisor1\",\n    \"revisor2\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/reviews/{{qId}}/assignments"
          }
        }
      ]
    },
    {
      "name": "2 · Historial",
      "item": [
        {
          "name": "Historial de la pregunta (autor)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// los eventos viajan por RabbitMQ: se espera un momento antes de consultar",
                  "setTimeout(function () {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('registra el envío y los cambios de estado', function () { var t = pm.response.json().map(function (e) { return e.tipo; }); pm.expect(t).to.include('PREGUNTA_ENVIADA'); pm.expect(t).to.include('CAMBIO_DE_ESTADO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAutor}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/history/questions/{{qId}}"
          }
        },
        {
          "name": "Historial de la pregunta (administrador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('el administrador ve también la asignación de revisores', function () { var t = pm.response.json().map(function (e) { return e.tipo; }); pm.expect(t).to.include('REVISORES_ASIGNADOS'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
