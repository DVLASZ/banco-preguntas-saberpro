    "name": "Banco de Preguntas · email-service",
    "description": "Registro de correos simulados que envía email-service al escuchar notification.created. Prepara una pregunta en revisión para generar avisos y consulta el registro como administrador. Ejecutar de arriba abajo con el entorno `SaberPro_Local`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 · Sesión",
      "item": [
        {
          "name": "Iniciar sesión como autor1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('trae un token de acceso', function () { pm.expect(j.access_token).to.be.a('string'); });",
                  "pm.collectionVariables.set('tokenAutor', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "bancopreguntas-web"
                },
                {
                  "key": "username",
                  "value": "autor1"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            },
            "url": "{{keycloakUrl}}/realms/bancopreguntas/protocol/openid-connect/token",
            "description": "Obtiene el JWT de Keycloak con el flujo de contraseña del cliente de pruebas locales y lo guarda en {{tokenAutor}}."
          }
        },
