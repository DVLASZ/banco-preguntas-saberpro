        {
          "name": "Preparar · publicarla",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// la decisión de la ronda viaja por RabbitMQ hasta lifecycle-service: se espera antes de publicar",
                  "setTimeout(function () {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('queda Publicada', function () { pm.expect(pm.response.json().estado).to.eql('PUBLICADA'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
