    {
      "name": "3 · RF-21 y RF-22 Generar un simulacro",
      "item": [
        {
          "name": "Generar un simulacro aleatorio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('el código de respuesta es el esperado (201)', function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "pm.test('empieza en curso con una pregunta y tiempo', function () { pm.expect(j.estado).to.eql('EN_CURSO'); pm.expect(j.preguntas.length).to.eql(1); pm.expect(j.segundosRestantes).to.be.above(0); });",
                  "pm.test('no revela la respuesta correcta', function () { pm.expect(j.preguntas[0]).to.not.have.property('respuestaCorrecta'); });",
                  "pm.collectionVariables.set('simId', j.id);",
                  "pm.collectionVariables.set('qSim', j.preguntas[0].preguntaId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante1}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"competencias\": [\n    \"LECTURA_CRITICA\"\n  ],\n  \"cantidad\": 1,\n  \"duracionMinutos\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/simulations"
          }
