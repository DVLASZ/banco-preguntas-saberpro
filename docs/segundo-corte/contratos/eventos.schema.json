{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bancopreguntas.local/schemas/eventos.schema.json",
  "title": "Eventos de dominio del Banco de Preguntas",
  "description": "Sobre común y cuerpo de cada evento publicado en el exchange bancopreguntas.events (topic). La routing key es igual al campo type.",
  "type": "object",
  "required": ["eventId", "type", "occurredAt", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid", "description": "Identificador único; los consumidores lo usan para la idempotencia" },
    "type": {
      "type": "string",
      "enum": [
        "question.submitted",
        "review.reviewers-assigned",
        "review.evaluation-submitted",
        "review.completed",
        "question.state-changed"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "question.submitted" },
        "data": { "$ref": "#/$defs/QuestionSubmitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "review.reviewers-assigned" },
        "data": { "$ref": "#/$defs/ReviewersAssigned" }
      }
    },
    {
      "properties": {
        "type": { "const": "review.evaluation-submitted" },
        "data": { "$ref": "#/$defs/EvaluationSubmitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "review.completed" },
        "data": { "$ref": "#/$defs/ReviewCompleted" }
      }
    },
    {
      "properties": {
        "type": { "const": "question.state-changed" },
        "data": { "$ref": "#/$defs/QuestionStateChanged" }
      }
    }
  ],
  "$defs": {
    "QuestionSubmitted": {
      "type": "object",
      "required": ["questionId", "authorId", "title", "competency"],
      "properties": {
        "questionId": { "type": "string", "format": "uuid" },
        "authorId": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "competency": { "type": "string" }
      }
    },
    "ReviewersAssigned": {
      "type": "object",
      "required": ["questionId", "authorId", "reviewerIds", "assignedBy"],
      "properties": {
        "questionId": { "type": "string", "format": "uuid" },
        "authorId": { "type": "string", "format": "uuid" },
        "reviewerIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "assignedBy": { "type": "string", "format": "uuid" }
      }
    },
    "EvaluationSubmitted": {
      "type": "object",
      "required": ["questionId", "reviewerId", "decision"],
      "properties": {
        "questionId": { "type": "string", "format": "uuid" },
        "reviewerId": { "type": "string", "format": "uuid" },
        "decision": { "type": "string", "enum": ["APROBAR", "RECHAZAR"] },
        "observation": { "type": "string" }
      }
    },
    "ReviewCompleted": {
      "type": "object",
      "required": ["questionId", "authorId", "result", "observations"],
      "properties": {
        "questionId": { "type": "string", "format": "uuid" },
        "authorId": { "type": "string", "format": "uuid" },
        "result": { "type": "string", "enum": ["APPROVED", "REJECTED"] },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reviewerId", "decision"],
            "properties": {
              "reviewerId": { "type": "string", "format": "uuid" },
              "decision": { "type": "string", "enum": ["APROBAR", "RECHAZAR"] },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "QuestionStateChanged": {
      "type": "object",
      "required": ["questionId", "from", "to", "changedBy"],
      "properties": {
        "questionId": { "type": "string", "format": "uuid" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "changedBy": { "type": ["string", "null"], "format": "uuid", "description": "Nulo cuando el cambio lo provoca un evento y no un usuario" }
      }
    }
  }
}
