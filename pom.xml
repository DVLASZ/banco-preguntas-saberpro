<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>co.unicauca.saberpro</groupId>
    <artifactId>banco-preguntas-saberpro</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Sistema de Banco de Preguntas Saber Pro</name>
    <description>
        Sistema para la Gestion, Validacion y Administracion de un Banco de
        Preguntas para la Preparacion de las Pruebas Saber Pro. Proyecto de
        curso de Ingenieria de Software II (Universidad del Cauca).

        Organizado como un MONOLITO MODULAR: un unico proceso/repositorio
        desplegable, pero dividido en modulos Maven con limites explicitos
        (cada uno declara de que otros depende en su propio pom.xml, en vez
        de compartir paquetes/tablas libremente). La idea, sugerida por la
        docente del curso, es que el proyecto eventualmente migre a
        microservicios: partir de un monolito ya modular hace ese cambio
        mucho mas simple que partir de un monolito con todo mezclado.
    </description>

    <modules>
        <module>modulo-usuarios</module>
        <module>modulo-preguntas</module>
        <module>modulo-simulacros</module>
        <module>app</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.10.2</junit.version>
        <mockito.version>5.12.0</mockito.version>
        <flatlaf.version>3.4.1</flatlaf.version>
        <sqlite.version>3.46.1.3</sqlite.version>
        <argon2.version>2.11</argon2.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-shade-plugin.version>3.5.3</maven-shade-plugin.version>
    </properties>

    <!--
        dependencyManagement centraliza las versiones: cada modulo declara la
        dependencia SIN version, y hereda la que se fija aqui. Evita que dos
        modulos terminen usando versiones distintas de la misma libreria.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Modulos internos del propio proyecto -->
            <dependency>
                <groupId>co.unicauca.saberpro</groupId>
                <artifactId>modulo-usuarios</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>co.unicauca.saberpro</groupId>
                <artifactId>modulo-preguntas</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>co.unicauca.saberpro</groupId>
                <artifactId>modulo-simulacros</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Librerias externas -->
            <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf</artifactId>
                <version>${flatlaf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>
            <dependency>
                <groupId>de.mkammerer</groupId>
                <artifactId>argon2-jvm</artifactId>
                <version>${argon2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Toda pruebas de todos los modulos usa JUnit 5 -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
